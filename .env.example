# ===== Binance trader =====
TRADER_NAME=熬鹰资本
PORTFOLIO_ID=5075281354358777856
BINANCE_BASE_URL=https://www.binance.com/bapi/futures/v1/friendly/future/copy-trade
BINANCE_REFERER=https://www.binance.com/zh-CN/copy-trading/lead-details/5075281354358777856?timeRange=30D
BINANCE_TIMEOUT_SECONDS=15

# 只监控最新数据：每轮先取最新 10 条；只有最新页全部是新记录时才向前补页
POLL_INTERVAL_SECONDS=5
PAGE_SIZE=10
LOOKBACK_DAYS=30
MAX_CATCHUP_PAGES=3

# ===== SQLite =====
DATABASE_PATH=./data/monitor.db
KEEP_EVENT_DAYS=30
KEEP_EVENT_COUNT=500

# ===== Email (SMTP) =====
# QQ 邮箱示例：smtp.qq.com / 465 / ssl
# Gmail 示例：smtp.gmail.com / 465 / ssl
# 163 邮箱示例：smtp.163.com / 465 / ssl
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_TO=
MAIL_SUBJECT_PREFIX=[熬鹰资本带单监控]

# ===== Status API =====
# 默认只监听本机；如需远程访问，建议通过 SSH 隧道或带认证的反向代理
API_HOST=127.0.0.1
API_PORT=8765
STATUS_API_TOKEN=
PUBLIC_BASE_URL=

# ===== Phase 1 虚拟镜像模拟（只模拟，不会真实下单）=====
MIRROR_ENABLED=true
MIRROR_FIXED_MARGIN_USDT=10
MIRROR_LEVERAGE=3
MIRROR_MAX_ORDER_MARGIN_USDT=10
MIRROR_MAX_TOTAL_MARGIN_USDT=50
MIRROR_MAX_SYMBOL_MARGIN_USDT=20
MIRROR_MAX_PRICE_DEVIATION_BPS=50
MIRROR_MAX_SIGNAL_AGE_SECONDS=120
MIRROR_MAX_DAILY_LOSS_USDT=10
# 留空表示不按交易对过滤；例如 BTCUSDT,ETHUSDT
MIRROR_ALLOWED_SYMBOLS=
MIRROR_MARKET_DATA_BASE_URL=https://fapi.binance.com
MIRROR_MARKET_DATA_TIMEOUT_SECONDS=10

LOG_LEVEL=INFO
TIMEZONE=Asia/Shanghai
